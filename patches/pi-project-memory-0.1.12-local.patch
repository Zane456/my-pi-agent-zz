+// Local patch: whitespace splitting sees a whole CJK sentence as one word.
+const CJK_TEXT = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/u;
+const WORD_SEGMENTER = new Intl.Segmenter(undefined, { granularity: "word" });
+
+function cjkWordCount(text: string): number {
+	if (!CJK_TEXT.test(text)) return 0;
+	let count = 0;
+	for (const segment of WORD_SEGMENTER.segment(text)) if (segment.isWordLike) count++;
+	return count;
+}
